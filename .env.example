# ─────────────────────────────────────────────────────────────────
# CarbonBridge — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/carbonbridge?schema=public

# ── Redis (optional — falls back to in-memory mock if unavailable) ─
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────
# Frontend origin (dev: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# ── File Uploads ──────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=10

# ── ML Price Intelligence Service ────────────────────────────────
# URL of the Python FastAPI ML service (run: cd ml-service && uvicorn app.main:app)
ML_SERVICE_URL=http://localhost:8000

# ── Google Gemini AI ─────────────────────────────────────────────
# Required for: CoA extraction, NLP requirement parsing, match explanations, assistant
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Logistics Configuration ───────────────────────────────────────
# Estimated cryogenic freight base rate (INR per km per tonne)
CRYO_FREIGHT_BASE_RATE_PER_KM=1.85
# Estimated average transit speed for scheduling (km/h)
CRYO_TRANSIT_ESTIMATE_KM_PER_HOUR=45
